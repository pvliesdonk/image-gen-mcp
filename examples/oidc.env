# OIDC authentication example. See docs/guides/authentication.md for setup.

# Public base URL of the deployed server, for example `https://mcp.example.com`. Required for OIDC. Also the fallback source of the MCP Apps domain when `app_domain` is unset.
IMAGE_GENERATION_MCP_BASE_URL=https://mcp.example.com
# OIDC discovery document URL, for example `https://auth.example.com/.well-known/openid-configuration`.
IMAGE_GENERATION_MCP_OIDC_CONFIG_URL=https://auth.example.com/.well-known/openid-configuration
# OIDC client identifier registered with the provider.
IMAGE_GENERATION_MCP_OIDC_CLIENT_ID=mcp-client
# OIDC client secret registered with the provider.
IMAGE_GENERATION_MCP_OIDC_CLIENT_SECRET=your-client-secret
# Expected `aud` claim; tokens issued for another audience are rejected.
IMAGE_GENERATION_MCP_OIDC_AUDIENCE=mcp-api
# Scopes a caller must present, space- or comma-separated. Defaults to `openid` in oidc-proxy mode.
IMAGE_GENERATION_MCP_OIDC_REQUIRED_SCOPES=
# Scopes advertised to MCP clients in protected-resource metadata, space- or comma-separated. Overrides the default `openid offline_access`; `oidc_required_scopes` is always added on top. Set this when the registered client is not permitted `offline_access`, or to have clients request extra claim scopes (such as `groups`) without also requiring them in every token.
IMAGE_GENERATION_MCP_OIDC_ADVERTISED_SCOPES=
# Signing key for issued tokens; used in oidc-proxy mode only. When unset, the key is derived deterministically from `oidc_client_secret`, so tokens survive a restart. Rotating that secret then invalidates every issued token. Set this explicitly to decouple token validity from secret rotation. Generate with `openssl rand -hex 32`.
IMAGE_GENERATION_MCP_OIDC_JWT_SIGNING_KEY=your-signing-key
# Validate the access token instead of the id token.
IMAGE_GENERATION_MCP_OIDC_VERIFY_ACCESS_TOKEN=false

# Deprecated alias for IMAGE_GENERATION_MCP_SD_WEBUI_HOST; logs a warning when used.
IMAGE_GENERATION_MCP_A1111_HOST=
# Deprecated alias for IMAGE_GENERATION_MCP_SD_WEBUI_MODEL; logs a warning when used.
IMAGE_GENERATION_MCP_A1111_MODEL=
# When true, write-tagged tools (image generation, transforms, uploads) are hidden from clients. Set false to enable them.
IMAGE_GENERATION_MCP_READ_ONLY=true
# Directory where generated images are saved. Created automatically on first use.
IMAGE_GENERATION_MCP_SCRATCH_DIR=~/.image-generation-mcp/images
# OpenAI API key. Enables the OpenAI provider (gpt-image-2, gpt-image-1.5, dall-e-3) when set.
IMAGE_GENERATION_MCP_OPENAI_API_KEY=
# Google API key. Enables the Gemini provider (gemini-3.1-flash-image and others) when set. Get a key at https://aistudio.google.com/apikey.
IMAGE_GENERATION_MCP_GOOGLE_API_KEY=
# SD WebUI base URL (such as http://localhost:7860). Enables the SD WebUI provider when set. Compatible with AUTOMATIC1111, Forge, reForge, and Forge-neo.
IMAGE_GENERATION_MCP_SD_WEBUI_HOST=
# SD WebUI checkpoint name, used for model-aware preset detection (SD 1.5 / SDXL / Lightning) and checkpoint override. Unset uses the instance's current model.
IMAGE_GENERATION_MCP_SD_WEBUI_MODEL=
# Provider used when no keyword triggers auto-selection: auto, openai, gemini, sd_webui, or placeholder. auto picks the first configured provider.
IMAGE_GENERATION_MCP_DEFAULT_PROVIDER=auto
# Maximum number of transformed image results (resize, crop, convert) kept in memory. Set 0 to disable caching.
IMAGE_GENERATION_MCP_TRANSFORM_CACHE_SIZE=64
# Comma-separated provider names that cost money; generate_image asks for confirmation (client elicitation) before using them. An empty value falls back to this default; to disable confirmation, set a value that names no provider (such as none).
IMAGE_GENERATION_MCP_PAID_PROVIDERS=openai
# Directory for style preset files (Markdown with YAML front matter). Created automatically if it does not exist.
IMAGE_GENERATION_MCP_STYLES_DIR=~/.image-generation-mcp/styles
# Allow reading input images from local filesystem paths. Off by default: only URLs and uploads are accepted.
IMAGE_GENERATION_MCP_ALLOW_LOCAL_FILE_INPUT=false
# Maximum accepted input image size in bytes.
IMAGE_GENERATION_MCP_MAX_INPUT_IMAGE_BYTES=20971520
# HTTP timeout in seconds when fetching remote image URLs (fetch_image and URL inputs).
IMAGE_GENERATION_MCP_FETCH_TIMEOUT_S=30.0
# Link lifetime in seconds when the caller requests no explicit TTL.
IMAGE_GENERATION_MCP_TRANSFER_TTL_DEFAULT_S=3600.0
# Ceiling in seconds a caller-requested link TTL is clamped to.
IMAGE_GENERATION_MCP_TRANSFER_TTL_MAX_S=86400.0
# Post-success grace window in seconds: a served token's TTL shrinks to this so a stalled transfer can retry within it.
IMAGE_GENERATION_MCP_TRANSFER_GRACE_TTL_S=60.0
# Crashed-handler reclaim window in seconds for an in-flight reservation.
IMAGE_GENERATION_MCP_TRANSFER_LEASE_S=60.0
# Maximum size in bytes of a single upload.
IMAGE_GENERATION_MCP_TRANSFER_MAX_UPLOAD_BYTES=104857600
