# Image Generation MCP environment variables (copy to .env and fill in).

# --- Server ---
# Transport the server speaks: `stdio` for local Claude Desktop/Code, `http` or `sse` for a network server.
# IMAGE_GENERATION_MCP_TRANSPORT=stdio
# Interface the HTTP server binds to.
# IMAGE_GENERATION_MCP_HOST=127.0.0.1
# TCP port for the HTTP server.
# IMAGE_GENERATION_MCP_PORT=8000
# Public base URL of the deployed server, e.g. `https://mcp.example.com`. Required for OIDC. Also the fallback source of the MCP Apps domain when `app_domain` is unset.
# IMAGE_GENERATION_MCP_BASE_URL=https://mcp.example.com
# Rename this server instance; defaults to the project name.
# IMAGE_GENERATION_MCP_SERVER_NAME=
# Replaces the default MCP instructions text sent to clients.
# IMAGE_GENERATION_MCP_INSTRUCTIONS=
# Mount path for the MCP endpoint.
# IMAGE_GENERATION_MCP_HTTP_PATH=/mcp

# --- Authentication ---
# Single shared bearer token; enables bearer auth unless `bearer_tokens_file` is set, which takes precedence.
# IMAGE_GENERATION_MCP_BEARER_TOKEN=<secret>
# OIDC discovery document URL, e.g. `https://auth.example.com/.well-known/openid-configuration`.
# IMAGE_GENERATION_MCP_OIDC_CONFIG_URL=https://auth.example.com/.well-known/openid-configuration
# OIDC client identifier registered with the provider.
# IMAGE_GENERATION_MCP_OIDC_CLIENT_ID=mcp-client
# OIDC client secret registered with the provider.
# IMAGE_GENERATION_MCP_OIDC_CLIENT_SECRET=your-client-secret
# Expected `aud` claim; tokens issued for another audience are rejected.
# IMAGE_GENERATION_MCP_OIDC_AUDIENCE=mcp-api
# Scopes a caller must present, space- or comma-separated. Defaults to `openid` in oidc-proxy mode.
# IMAGE_GENERATION_MCP_OIDC_REQUIRED_SCOPES=
# Signing key for issued JWTs; used in oidc-proxy mode only. When unset, the key is derived deterministically from `oidc_client_secret`, so tokens survive a restart — but rotating that secret invalidates every issued token. Set this explicitly to decouple token validity from secret rotation. Generate with `openssl rand -hex 32`.
# IMAGE_GENERATION_MCP_OIDC_JWT_SIGNING_KEY=your-signing-key
# Validate the access token instead of the id token.
# IMAGE_GENERATION_MCP_OIDC_VERIFY_ACCESS_TOKEN=false
# Explicit auth-mode override, accepting `remote` or `oidc-proxy` (case- and whitespace-insensitive). When unset the mode is auto-detected from which auth variables are set; the override exists because having all four OIDC variables set is ambiguous between those two modes. Other values are ignored with a warning.
# IMAGE_GENERATION_MCP_AUTH_MODE=
# Path to a TOML file mapping bearer tokens to subjects; overrides the single-token `bearer_token` mode.
# IMAGE_GENERATION_MCP_BEARER_TOKENS_FILE=/etc/image-generation-mcp/tokens.toml
# Subject assigned to the single-token bearer mode; ignored when `bearer_tokens_file` is set, since mapped mode carries per-token subjects.
# IMAGE_GENERATION_MCP_BEARER_DEFAULT_SUBJECT=bearer-anon

# --- Persistence ---
# Persistent-state backend URL shared by every pvl-core subsystem that needs state. `memory://` is in-process and lost on restart; `file:///path` persists on one server; `redis://`, `dynamodb://` and `mongodb://` each need their matching extra. Defaults to `file:///data/state` when unset.
# IMAGE_GENERATION_MCP_KV_STORE_URL=
# Legacy state-backend override, honoured by `build_event_store` and `build_kv_store` only when `kv_store_url` is unset — it then backs every namespace, not just HTTP resumability. Prefer `kv_store_url` for new deployments.
# IMAGE_GENERATION_MCP_EVENT_STORE_URL=

# --- MCP Apps ---
# MCP Apps iframe domain, used for CSP sandboxing. Overrides the host derived from `base_url`.
# IMAGE_GENERATION_MCP_APP_DOMAIN=

# --- Logging ---
# Log level for FastMCP internals and app loggers (DEBUG / INFO / WARNING / ERROR / CRITICAL). The -v CLI flag overrides to DEBUG.
# FASTMCP_LOG_LEVEL=INFO
# Set false for plain or structured JSON log output.
# FASTMCP_ENABLE_RICH_LOGGING=true

# --- Container runtime (Docker / Compose) ---
# Run the server process as this UID; the container entrypoint chowns writable paths to match.
# PUID=1000
# Run the server process as this GID; pair with PUID to match the owner of a mounted volume.
# PGID=1000

# --- Remote debugger (development only) ---
# debugpy listen port; the image must be built with --build-arg DEBUG=true.
# IMAGE_GENERATION_MCP_DEBUG_PORT=5678
# Block startup until a debugger attaches.
# IMAGE_GENERATION_MCP_DEBUG_WAIT=false

# --- Domain ---
# Populated from your ProjectConfig CONFIG-FIELDS block.
# Deprecated alias for IMAGE_GENERATION_MCP_SD_WEBUI_HOST; logs a warning when used.
# IMAGE_GENERATION_MCP_A1111_HOST=
# Deprecated alias for IMAGE_GENERATION_MCP_SD_WEBUI_MODEL; logs a warning when used.
# IMAGE_GENERATION_MCP_A1111_MODEL=
# When true, write-tagged tools (image generation, transforms, uploads) are hidden from clients. Set false to enable them.
# IMAGE_GENERATION_MCP_READ_ONLY=true
# Directory where generated images are saved. Created automatically on first use.
# IMAGE_GENERATION_MCP_SCRATCH_DIR=~/.image-generation-mcp/images
# OpenAI API key. Enables the OpenAI provider (gpt-image-2, gpt-image-1.5, dall-e-3) when set.
# IMAGE_GENERATION_MCP_OPENAI_API_KEY=
# Google API key. Enables the Gemini provider (gemini-3.1-flash-image and others) when set. Get a key at https://aistudio.google.com/apikey.
# IMAGE_GENERATION_MCP_GOOGLE_API_KEY=
# SD WebUI base URL (such as http://localhost:7860). Enables the SD WebUI provider when set. Compatible with AUTOMATIC1111, Forge, reForge, and Forge-neo.
# IMAGE_GENERATION_MCP_SD_WEBUI_HOST=
# SD WebUI checkpoint name, used for model-aware preset detection (SD 1.5 / SDXL / Lightning) and checkpoint override. Unset uses the instance's current model.
# IMAGE_GENERATION_MCP_SD_WEBUI_MODEL=
# Provider used when no keyword triggers auto-selection: auto, openai, gemini, sd_webui, or placeholder. auto picks the first configured provider.
# IMAGE_GENERATION_MCP_DEFAULT_PROVIDER=auto
# Maximum number of transformed image results (resize, crop, convert) kept in memory. Set 0 to disable caching.
# IMAGE_GENERATION_MCP_TRANSFORM_CACHE_SIZE=64
# Comma-separated provider names that cost money; generate_image asks for confirmation (client elicitation) before using them. Set empty to disable confirmation.
# IMAGE_GENERATION_MCP_PAID_PROVIDERS=openai
# Directory for style preset files (Markdown with YAML front matter). Created automatically if it does not exist.
# IMAGE_GENERATION_MCP_STYLES_DIR=~/.image-generation-mcp/styles
# Allow reading input images from local filesystem paths. Off by default: only URLs and uploads are accepted.
# IMAGE_GENERATION_MCP_ALLOW_LOCAL_FILE_INPUT=false
# Maximum accepted input image size in bytes.
# IMAGE_GENERATION_MCP_MAX_INPUT_IMAGE_BYTES=20971520
# Default lifetime in seconds of a create_download_link / create_upload_link URL when the caller omits one. HTTP transports only.
# IMAGE_GENERATION_MCP_TRANSFER_TTL_DEFAULT_S=3600.0
# Ceiling in seconds a caller-requested transfer-link lifetime is clamped to.
# IMAGE_GENERATION_MCP_TRANSFER_TTL_MAX_S=86400.0
# Post-success grace window in seconds a one-time transfer link stays reclaimable, so a stalled download can retry.
# IMAGE_GENERATION_MCP_TRANSFER_GRACE_TTL_S=60.0
# Reclaim window in seconds for an in-flight transfer whose handler crashed.
# IMAGE_GENERATION_MCP_TRANSFER_LEASE_S=60.0
# Per-upload size cap in bytes for create_upload_link bodies.
# IMAGE_GENERATION_MCP_TRANSFER_MAX_UPLOAD_BYTES=104857600
# HTTP timeout in seconds when fetching remote image URLs (fetch_image and URL inputs).
# IMAGE_GENERATION_MCP_FETCH_TIMEOUT_S=30.0
